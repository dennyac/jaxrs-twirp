<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dennyac.twirp</groupId>
        <artifactId>jaxrs-twirp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dropwizard-twirp</artifactId>
    <name>Dropwizard Twirp Runtime</name>
    <description>
        Dropwizard integration for Twirp: the TwirpBundle that wires the
        framework-agnostic jaxrs-twirp-core providers into Dropwizard's
        Jersey runtime, plus the managed TwirpClientBuilder. Install this module
        in a Dropwizard application to serve and call Twirp services (v7).
    </description>

    <properties>
        <module.name>com.dennyac.twirp</module.name>
    </properties>

    <dependencies>
        <!-- The framework-agnostic JAX-RS runtime this module adapts to Dropwizard. -->
        <dependency>
            <groupId>com.dennyac.twirp</groupId>
            <artifactId>jaxrs-twirp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-jersey</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <!--
            Optional: only TwirpClientBuilder.using(Environment, JerseyClientConfiguration)
            needs dropwizard-client (to build a managed JAX-RS client). Marked optional so
            server-only consumers don't pull it transitively; client-side consumers that use
            the managed-builder overload add dropwizard-client to their own module. The
            WebTarget / using(Client) paths work with just the JAX-RS API above.
        -->
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-client</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- TwirpBundle configures the JSON printer/parser and Any TypeRegistry. -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
