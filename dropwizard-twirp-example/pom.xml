<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dennyac.twirp</groupId>
        <artifactId>jaxrs-twirp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dropwizard-twirp-example</artifactId>
    <name>Dropwizard Twirp Example</name>
    <description>
        End-to-end example: a Dropwizard 5 application serving the canonical
        Haberdasher Twirp service generated by the JAX-RS Twirp protoc plugin.
    </description>

    <properties>
        <!-- This module is a runnable demo, not a published library artifact. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dennyac.twirp</groupId>
            <artifactId>dropwizard-twirp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <!--
            Test-scope: GeneratedClientIntegrationTest uses
            dropwizard-client's JerseyClientBuilder to exercise the generated
            HaberdasherClient against the running server. The example app
            itself doesn't make any outbound HTTP calls, so we keep this off
            the runtime classpath.
        -->
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-client</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>compile-protos</id>
                        <goals>
                            <!-- 'compile' invokes protoc's built-in java output plus
                                 any pure-Java plugins declared in protocPlugins. -->
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <protocPlugins>
                                <protocPlugin>
                                    <id>twirp_java</id>
                                    <groupId>com.dennyac.twirp</groupId>
                                    <artifactId>jaxrs-twirp-protoc</artifactId>
                                    <version>${project.version}</version>
                                    <mainClass>com.dennyac.twirp.protoc.Main</mainClass>
                                    <args>
                                        <arg>context=true</arg>
                                    </args>
                                </protocPlugin>
                            </protocPlugins>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Shade into a runnable fat jar so the README's `java -jar
                dropwizard-twirp-example-*.jar server …` / `… twirp-generate …`
                invocations work without extra build glue. Standard Dropwizard
                fat-jar config: merge META-INF/services entries so JAX-RS /
                Jersey / Jakarta provider discovery still works, drop signed
                jar signatures, and set Main-Class to the application.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!--
                                            Drop JPMS descriptors when shading: the fat jar
                                            isn't placed on the module path, so these only
                                            generate "strong encapsulation" warnings.
                                        -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.dennyac.twirp.example.ExampleApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
