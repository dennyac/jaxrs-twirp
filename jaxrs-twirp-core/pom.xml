<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dennyac.twirp</groupId>
        <artifactId>jaxrs-twirp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jaxrs-twirp-core</artifactId>
    <name>JAX-RS Twirp Core</name>
    <description>
        Framework-agnostic JAX-RS runtime for the Twirp RPC protocol (v7):
        protobuf/JSON MessageBody providers, the Twirp error model and exception
        mappers, and the client/server helpers used by generated code. Depends
        only on the JAX-RS API (plus protobuf, Jackson, SLF4J) — no Dropwizard.
    </description>

    <properties>
        <!--
            Distinct automatic-module name from the dropwizard-twirp veneer. Both
            jars share the com.dennyac.twirp package (a deliberate split package)
            so they are designed for the classpath, not the JPMS module path; the
            name here is advisory only.
        -->
        <module.name>com.dennyac.twirp.core</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>
        <!-- TwirpClients decodes error envelopes; TwirpError carries Jackson bindings. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- TwirpExceptionMapper logs 5xx causes. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!--
            protobuf-java-util's JsonFormat references Guava (ImmutableSet,
            Preconditions). The parent BOM excludes Guava from protobuf-java-util
            to avoid an old transitive version, so re-add the BOM-aligned Guava
            here as a real runtime dependency; without it a pure-JAX-RS consumer
            hits NoClassDefFoundError the first time JSON is read/written.
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!--
            Test-only: dropwizard-testing's ResourceExtension is a convenient
            in-memory Jersey harness for exercising the providers and mappers.
            It never leaks onto the main classpath, so the published artifact
            stays Dropwizard-free.
        -->
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
